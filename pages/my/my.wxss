/* pages/my/my.wxss */
.container {
  background: var(--bg-page);
  min-height: 100vh;
}

/* ========== 用户卡片 ========== */
.user-card {
  position: relative;
  padding-bottom: 48rpx;
  margin-bottom: 28rpx;
}

.user-card-bg {
  height: 240rpx;
  background: linear-gradient(145deg, #059669 0%, #10b981 40%, #06b6d4 100%);
  border-radius: 0 0 56rpx 56rpx;
  position: relative;
  overflow: hidden;
}

/* 背景装饰纹理 */
.user-card-bg::after {
  content: '';
  position: absolute;
  top: -40rpx;
  right: -40rpx;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.user-card-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: -96rpx;
  position: relative;
  z-index: 2;
}

.avatar-btn {
  background: transparent;
  border: none;
  padding: 0;
  margin: 0;
  line-height: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-btn::after {
  display: none;
}

.avatar-ring {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 6rpx solid #ffffff;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
  overflow: hidden;
  background: var(--bg-input);
}

.avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

/* 头像编辑提示 */
.avatar-ring {
  position: relative;
}

.avatar-edit-hint {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 44rpx;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0 0 50% 50%;
}

.avatar-edit-icon {
  font-size: 22rpx;
}

/* 新用户引导 */
.profile-guide {
  margin-top: 16rpx;
  padding: 10rpx 28rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: var(--radius-pill);
}

.profile-guide-text {
  font-size: 22rpx;
  color: rgba(0, 0, 0, 0.5);
  letter-spacing: 1rpx;
}

.nickname-row {
  margin-top: 16rpx;
  margin-bottom: 8rpx;
}

.nickname-input {
  font-size: 36rpx;
  color: var(--text-primary);
  font-weight: 700;
  text-align: center;
  width: 320rpx;
}

.nickname {
  font-size: 36rpx;
  color: var(--text-primary);
  font-weight: 700;
  margin-top: 16rpx;
  margin-bottom: 16rpx;
}

/* 信用分 */
.credit-pill {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 28rpx;
  background: var(--bg-card);
  border-radius: var(--radius-pill);
  box-shadow: var(--shadow-card);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  margin-top: 8rpx;
}

.credit-score {
  font-size: 30rpx;
  font-weight: 800;
}

.credit-excellent { color: #2e7d32; }
.credit-good      { color: #1565c0; }
.credit-normal    { color: var(--text-secondary); }
.credit-warning   { color: #e67e22; }
.credit-poor      { color: #e74c3c; }

.credit-label {
  font-size: 22rpx;
  color: var(--text-hint);
}

.login-btn {
  margin-top: 20rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--primary-color);
  background: var(--primary-light);
  border: none;
  padding: 14rpx 64rpx;
  border-radius: var(--radius-pill);
  letter-spacing: 2rpx;
  transition: all var(--duration-normal) var(--ease-out);
}

.login-btn:active {
  transform: scale(0.95);
  opacity: 0.85;
}

/* ========== 菜单组 ========== */
.menu-group {
  background: var(--bg-card);
  margin: 0 24rpx 28rpx;
  border-radius: var(--radius-card);
  overflow: hidden;
  border: 1rpx solid rgba(0, 0, 0, 0.03);
  box-shadow: var(--shadow-card);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx 28rpx;
  gap: 20rpx;
  position: relative;
  transition: background var(--duration-fast) var(--ease-smooth);
}

.menu-item:active {
  background: var(--bg-hover);
}

.menu-item:not(:last-child)::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 92rpx;
  right: 28rpx;
  height: 1rpx;
  background: var(--border-light);
}

.menu-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: var(--bg-input);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.menu-icon {
  font-size: 30rpx;
}

.menu-text {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.menu-arrow {
  font-size: 36rpx;
  color: var(--text-muted);
  flex-shrink: 0;
  font-weight: 300;
}

/* 未读角标 */
.badge {
  background: #e74c3c;
  color: #fff;
  font-size: 18rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  border-radius: var(--radius-pill);
  padding: 0 8rpx;
  flex-shrink: 0;
  font-weight: 600;
}

/* ========== 退出登录 ========== */
.logout-wrap {
  padding: 16rpx 24rpx 80rpx;
}

.logout-btn {
  padding: 26rpx 0;
  text-align: center;
  border-radius: var(--radius-card);
  background: var(--bg-card);
  border: 1rpx solid rgba(0, 0, 0, 0.03);
  box-shadow: var(--shadow-xs);
  transition: all var(--duration-fast) var(--ease-out);
}

.logout-btn:active {
  background: #fef2f2;
  transform: scale(0.98);
}

.logout-text {
  font-size: 28rpx;
  color: #ef4444;
  font-weight: 600;
  letter-spacing: 2rpx;
}

/* ========== 运动偏好 ========== */
.section-header {
  padding: 24rpx 28rpx 8rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  margin-bottom: 4rpx;
}

.section-hint {
  font-size: 22rpx;
  color: var(--text-hint);
  display: block;
  letter-spacing: 1rpx;
}

.sport-prefs-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 16rpx 20rpx 28rpx;
  gap: 16rpx;
}

.sport-pref-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  width: calc(25% - 12rpx);
  padding: 20rpx 0;
  border-radius: var(--radius-md);
  background: var(--bg-input);
  border: 2rpx solid transparent;
  transition: all var(--duration-normal) var(--ease-spring);
}

.sport-pref-item:active {
  transform: scale(0.93);
}

.sport-pref-item.active {
  background: var(--primary-light);
  border-color: rgba(5, 150, 105, 0.2);
  box-shadow: 0 4rpx 12rpx rgba(5, 150, 105, 0.1);
}

.sport-pref-emoji {
  font-size: 42rpx;
}

.sport-pref-name {
  font-size: 22rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.sport-pref-item.active .sport-pref-name {
  color: var(--primary-color);
  font-weight: 700;
}
