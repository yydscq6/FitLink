.container { background: var(--bg-page); min-height: 100vh; }

/* ========== 分类 Tab 栏 ========== */
.tab-bar {
  display: flex;
  background: #ffffff;
  padding: 0 16rpx;
  border-bottom: 1rpx solid var(--border-light);
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 26rpx 0;
  position: relative;
  transition: all var(--duration-normal) var(--ease-out);
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 25%;
  right: 25%;
  height: 4rpx;
  background: var(--primary-color);
  border-radius: 2rpx;
  animation: fadeIn var(--duration-fast) var(--ease-out);
}

.tab-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 500;
  letter-spacing: 0.5rpx;
}

.tab-item.active .tab-label {
  color: var(--primary-color);
  font-weight: 700;
}

.tab-count {
  font-size: 18rpx;
  min-width: 30rpx;
  height: 30rpx;
  line-height: 30rpx;
  text-align: center;
  background: var(--border-color);
  color: #ffffff;
  border-radius: var(--radius-pill);
  padding: 0 8rpx;
  font-weight: 700;
}

.tab-item.active .tab-count {
  background: var(--primary-color);
}

/* ========== 通知列表 ========== */
.notif-item {
  display: flex;
  align-items: flex-start;
  padding: 28rpx 32rpx;
  background: var(--bg-card);
  border-bottom: 1rpx solid var(--border-light);
  gap: 20rpx;
  position: relative;
  transition: background var(--duration-fast) var(--ease-smooth);
}

.notif-item:active {
  background: var(--bg-hover);
}

.notif-item.unread {
  background: rgba(5, 150, 105, 0.03);
  border-left: 4rpx solid var(--primary-color);
}

.notif-icon {
  font-size: 38rpx;
  flex-shrink: 0;
  margin-top: 6rpx;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-input);
  border-radius: 14rpx;
}

.notif-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.notif-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
}

.notif-content {
  font-size: 26rpx;
  color: var(--text-secondary);
  display: block;
  line-height: 1.6;
}

.notif-time {
  font-size: 22rpx;
  color: var(--text-hint);
  margin-top: 4rpx;
  letter-spacing: 0.5rpx;
}

.unread-dot {
  width: 16rpx;
  height: 16rpx;
  background: #ef4444;
  border-radius: 50%;
  flex-shrink: 0;
  margin-top: 20rpx;
  box-shadow: 0 0 8rpx rgba(239, 68, 68, 0.3);
}

.skeleton-card {
  margin: 16rpx 24rpx;
  padding: 28rpx;
  background: var(--bg-card);
  border-radius: var(--radius-card);
  border: 1rpx solid rgba(0, 0, 0, 0.03);
}

.skeleton-title { height: 36rpx; width: 35%; margin-bottom: 16rpx; }
.skeleton-line { height: 28rpx; width: 65%; }

.mark-read-bar {
  display: flex;
  justify-content: flex-end;
  padding: 16rpx 32rpx;
  background: #ffffff;
  border-bottom: 1rpx solid var(--border-light);
}

.mark-read-text {
  font-size: 26rpx;
  color: var(--primary-color);
  font-weight: 600;
  letter-spacing: 1rpx;
  transition: opacity var(--duration-fast) var(--ease-out);
}

.mark-read-text:active {
  opacity: 0.6;
}
