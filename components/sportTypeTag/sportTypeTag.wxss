/* components/sportTypeTag/sportTypeTag.wxss */
.sport-tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 18rpx;
  border-radius: 100rpx;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}

.sport-tag.basketball { background: rgba(255, 152, 0, 0.1); color: #e65100; }
.sport-tag.football   { background: rgba(244, 67, 54, 0.08); color: #bf360c; }
.sport-tag.badminton  { background: rgba(76, 175, 80, 0.1); color: #2e7d32; }
.sport-tag.running    { background: rgba(33, 150, 243, 0.1); color: #1565c0; }
.sport-tag.tennis     { background: rgba(156, 39, 176, 0.08); color: #6a1b9a; }
.sport-tag.swimming   { background: rgba(3, 169, 244, 0.08); color: #0277bd; }
.sport-tag.volleyball { background: rgba(255, 193, 7, 0.1); color: #f57f17; }
.sport-tag.pingpong   { background: rgba(255, 152, 0, 0.1); color: #e65100; }
.sport-tag.hiking     { background: rgba(121, 85, 72, 0.08); color: #5d4037; }
.sport-tag.cycling    { background: rgba(0, 150, 136, 0.08); color: #00695c; }
.sport-tag.fitness    { background: rgba(233, 30, 99, 0.08); color: #ad1457; }
.sport-tag.other      { background: rgba(158, 158, 158, 0.1); color: #616161; }
