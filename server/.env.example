# ===========================================
# 运动组局小程序 — 后端环境变量配置
# 复制为 .env 后填入真实值
# ===========================================

# 服务端口
PORT=3000

# Node 环境 (development / production)
NODE_ENV=development

# JWT 密钥（生产环境请使用随机强密钥，至少 32 位）
JWT_SECRET=your-strong-random-secret-at-least-32-chars

# CORS 允许域名（逗号分隔，生产环境只允许小程序域名）
# CORS_ORIGINS=https://api.example.com,https://admin.example.com

# 腾讯地图 WebService API Key
QQ_MAP_KEY=your-qq-map-key

# 微信小程序 AppID / AppSecret
WX_APPID=your-wx-appid
WX_SECRET=your-wx-secret

# 微信订阅消息模板 ID
WX_TEMPLATE_REMINDER=
WX_TEMPLATE_STATUS=

# 数据库文件路径（默认 ./data/sport.db）
DB_PATH=./data/sport.db

# 管理员用户 openid（逗号分隔，用于举报处理等管理功能）
ADMIN_OPENIDS=
